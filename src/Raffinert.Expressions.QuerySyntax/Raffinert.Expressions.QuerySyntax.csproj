<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Raffinert.Expressions.QuerySyntax</AssemblyName>
    <RootNamespace>Raffinert.Expressions</RootNamespace>
    <Version>1.0.3</Version>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageId>Raffinert.Expressions.QuerySyntax</PackageId>
    <Title>Raffinert.Expressions.QuerySyntax</Title>
    <Authors>Yevhen Cherkes</Authors>
    <Copyright>Copyright (c) 2026 Raffinert</Copyright>
    <Description>An opt-in LINQ query-syntax facade for Raffinert.Expressions with async enumeration support.</Description>
    <PackageTags>LINQ;Expressions;ExpressionTree;QuerySyntax;EFCore;Composable;AsyncEnumerable</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Raffinert/Raffinert.Expressions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Raffinert/Raffinert.Expressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Raffinert/Raffinert.Expressions/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Raffinert.Expressions\Raffinert.Expressions.csproj" />
  </ItemGroup>
</Project>
