<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AssemblyName>Raffinert.Expressions.EntityFrameworkCore</AssemblyName>
    <RootNamespace>Raffinert.Expressions</RootNamespace>
    <Version>2.1.0</Version>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageId>Raffinert.Expressions.EntityFrameworkCore</PackageId>
    <Title>Raffinert.Expressions.EntityFrameworkCore</Title>
    <Authors>Yevhen Cherkes</Authors>
    <Copyright>Copyright (c) 2026 Raffinert</Copyright>
    <Description>EF Core 10 and 11 async condition operators and opt-in expression expansion before native EF parameter extraction for Raffinert.Expressions. Requires .NET 10 with EF Core 10, or .NET 11 with EF Core 11.</Description>
    <PackageTags>LINQ;Expressions;EFCore;Condition;Projection;Async;Interceptor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Raffinert/Raffinert.Expressions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Raffinert/Raffinert.Expressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Raffinert/Raffinert.Expressions/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Raffinert.Expressions\Raffinert.Expressions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.11,11.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.11,11.0.0)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[11.0.0,12.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[11.0.0,12.0.0)" />
  </ItemGroup>
</Project>
