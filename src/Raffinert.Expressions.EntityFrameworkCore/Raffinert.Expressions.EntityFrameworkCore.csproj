<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Raffinert.Expressions.EntityFrameworkCore</AssemblyName>
    <RootNamespace>Raffinert.Expressions</RootNamespace>
    <Version>1.2.0</Version>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageId>Raffinert.Expressions.EntityFrameworkCore</PackageId>
    <Title>Raffinert.Expressions.EntityFrameworkCore</Title>
    <Authors>Yevhen Cherkes</Authors>
    <Copyright>Copyright (c) 2026 Raffinert</Copyright>
    <Description>EF Core async condition operators and opt-in expression expansion for Raffinert.Expressions.</Description>
    <PackageTags>LINQ;Expressions;EFCore;Condition;Projection;Async;Interceptor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Raffinert/Raffinert.Expressions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Raffinert/Raffinert.Expressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Raffinert/Raffinert.Expressions/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Raffinert.Expressions\Raffinert.Expressions.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>
</Project>
