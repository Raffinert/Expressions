<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Raffinert.Expressions</AssemblyName>
    <RootNamespace>Raffinert.Expressions</RootNamespace>
    <Version>1.0.1</Version>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageId>Raffinert.Expressions</PackageId>
    <Title>Raffinert.Expressions</Title>
    <Authors>Yevhen Cherkes</Authors>
    <Copyright>Copyright (c) 2026 Raffinert</Copyright>
    <Description>Lightweight composable and structurally adaptable expression trees for reusable conditions, projections, and LINQ/EF Core query logic.</Description>
    <PackageTags>LINQ;Expressions;ExpressionTree;Condition;Predicate;Projection;EFCore;Composable;Selector</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Raffinert/Raffinert.Expressions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Raffinert/Raffinert.Expressions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/Raffinert/Raffinert.Expressions/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
