<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Older runtimes are exercised only as compatibility baselines. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <!-- These test host/adapter versions still run on the EF 7 net6.0 baseline. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Raffinert.Expressions.EntityFrameworkCore\Raffinert.Expressions.EntityFrameworkCore.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\src\Raffinert.Expressions.QuerySyntax\Raffinert.Expressions.QuerySyntax.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)..\Raffinert.Expressions.EntityFrameworkCore.IntegrationTests\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
