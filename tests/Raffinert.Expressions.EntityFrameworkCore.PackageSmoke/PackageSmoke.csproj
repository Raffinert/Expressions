<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <EfCoreVersion Condition="'$(EfCoreVersion)' == ''">10.0.11</EfCoreVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- A private cache prevents a previously restored 1.2.0 package masking local changes. -->
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages/$(EfCoreVersion)</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raffinert.Expressions.EntityFrameworkCore" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
  </ItemGroup>
</Project>
