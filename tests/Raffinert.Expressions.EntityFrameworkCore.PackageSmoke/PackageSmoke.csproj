<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A private cache prevents a previously restored 1.2.0 package masking local changes. -->
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages/ef10</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raffinert.Expressions.EntityFrameworkCore" Version="1.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
